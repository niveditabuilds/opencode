{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/voice-client",
  "version": "1.17.8",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "exports": {
    "./api": "./src/api.ts",
    "./log": {
      "browser": "./src/log.browser.ts",
      "default": "./src/log.node.ts"
    },
    "./panel": "./src/panel.ts",
    "./play": {
      "browser": "./src/play.browser.ts",
      "default": "./src/play.node.ts"
    },
    "./progress": "./src/progress.ts",
    "./reply": "./src/reply.ts",
    "./runtime": "./src/runtime.ts",
    "./store": "./src/store.ts",
    "./sidecar": "./src/sidecar.ts",
    "./speak": "./src/speak.ts",
    "./sidecar-url": {
      "browser": "./src/sidecar-url.browser.ts",
      "default": "./src/sidecar-url.node.ts"
    },
    "./url": "./src/url.ts"
  },
  "imports": {
    "#log": {
      "browser": "./src/log.browser.ts",
      "default": "./src/log.node.ts"
    },
    "#play": {
      "browser": "./src/play.browser.ts",
      "default": "./src/play.node.ts"
    },
    "#sidecar-url": {
      "browser": "./src/sidecar-url.browser.ts",
      "default": "./src/sidecar-url.node.ts"
    }
  },
  "dependencies": {
    "@opencode-ai/sdk": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
